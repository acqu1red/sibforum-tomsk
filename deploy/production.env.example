# Store the completed file at /etc/sibforum/production.env, mode 600.
DOMAIN=sibforum-tomsk.ru
ADMIN_DOMAIN=admin.sibforum-tomsk.ru
ADMIN_OWNER_USERNAME=director
# Temporarily disabled at the owner's request; set to 1 to require TOTP again.
ADMIN_TOTP_REQUIRED=0
BIND_IP=0.0.0.0
# Set to 1 only after configuring and testing SMTP and SmartCaptcha.
PUBLIC_SUBMISSIONS_ENABLED=0
SECRET_KEY=
POSTGRES_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=
YANDEX_SMARTCAPTCHA_SECRET=
YANDEX_SMARTCAPTCHA_CLIENT_ID=
# Optional certificate expiry contact. Renewal also runs via systemd timer.
TLS_EMAIL=
